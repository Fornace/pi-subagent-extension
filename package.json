{
  "name": "pi-subagent-extension",
  "version": "1.2.0",
  "description": "Subagent delegation for pi: single, parallel, and chained runs in isolated pi processes, with a user-defined agent roster, model resolution, and slash commands.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "subagent",
    "agents",
    "delegation",
    "parallel",
    "orchestration",
    "isolated-context"
  ],
  "author": "Francesco Frapporti <effedue@gmail.com>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fornace/pi-subagent-extension.git"
  },
  "files": [
    "index.ts",
    "subagent-common.ts",
    "subagent-runner.ts",
    "subagent-execute.ts",
    "subagent-render.ts",
    "subagent-tool.ts",
    "managed-spawn-tool.ts",
    "managed-control-tools.ts",
    "managed-wait-tool.ts",
    "managed-workspace-tool.ts",
    "agent-manager.ts",
    "managed-launch.ts",
    "child-admission.ts",
    "agent-events.ts",
    "activity.ts",
    "child-policy.ts",
    "child-lifecycle.ts",
    "child-owner.ts",
    "owner-guard.ts",
    "agent-manager-support.ts",
    "agent-wait.ts",
    "agent-rpc-prompts.ts",
    "agent-runtime.ts",
    "agents.ts",
    "model-resolver.ts",
    "model-catalog.ts",
    "settings-page.ts",
    "workspace.ts",
    "routing-policy.ts",
    "tools",
    "skills",
    "agents",
    "prompts",
    "README.md",
    "CHANGELOG.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node test-load.js"
  },
  "dependencies": {
    "pi-frontier": "^1.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
